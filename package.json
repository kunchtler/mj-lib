{
  "name": "musicaljuggling",
  "description": "Parse, visualise and simulate (musical) juggling patterns.",
  "private": true,
  "version": "0.0.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "author": {
    "name": "Léo Kulinski",
    "email": "leo.kulinski@universite-paris-saclay.fr"
  },
  "repository": {
    "type": "git",
    "url": "github+https://github.com/kunchtler/mj-lib"
  },
  "bugs": {
    "url": "https://github.com/kunchtler/mj-lib/issues"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "juggling",
    "juggle",
    "juggler",
    "simulator",
    "siteswap",
    "music",
    "musical",
    "three",
    "javascript",
    "typescript"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite --port 8080",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.7.4",
    "@eslint/js": "^9.39.2",
    "@laynezh/vite-plugin-lib-assets": "^2.1.3",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.17.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.1",
    "ts-json-schema-generator": "^2.4.0",
    "tsx": "^4.21.0",
    "type-testing": "^0.2.0",
    "typedoc": "^0.28.16",
    "typedoc-plugin-coverage": "^4.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "~8.48.1",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "~0.10.0",
    "vitest": "4.0.16"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/uikit": "^0.8.21",
    "@react-three/xr": "^6.6.29",
    "@tabler/icons-react": "^3.36.1",
    "antlr4": "^4.13.2",
    "fraction.js": "^5.3.4",
    "immer": "^10.2.0",
    "immutable": "^5.1.4",
    "js-sdsl": "^4.4.2",
    "merge-refs": "^2.0.0",
    "react": "~19.1.4",
    "react-dom": "^19.2.3",
    "three": "^0.176.0",
    "use-immer": "^0.11.0"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "none",
    "singleQuote": false,
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false
  }
}